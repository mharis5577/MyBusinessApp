<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/home_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_name"
        android:textColor="#E8DCC8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_widget_profit_label"
                android:textColor="#9AA09A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_widget_profit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_widget_placeholder"
                android:textColor="#00B3A6"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_widget_overdue_label"
                android:textColor="#9AA09A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_widget_overdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_widget_placeholder"
                android:textColor="#F0C674"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
